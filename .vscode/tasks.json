{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Install Dependencies",
            "type": "shell",
            "command": ".venv\\Scripts\\pip.exe install -r requirements.txt",
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "Create Virtual Environment",
            "type": "shell",
            "command": "python -m venv .venv",
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "Run Streamlit App",
            "type": "shell",
            "command": ".venv\\Scripts\\streamlit.exe run app/streamlit_app.py",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "options": {
                "env": {
                    "PYTHONPATH": "${workspaceFolder}/src;${workspaceFolder}"
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "Run ML Pipeline",
            "type": "shell",
            "command": ".venv\\Scripts\\python.exe scripts/run_full_pipeline.py",
            "group": "build",
            "options": {
                "env": {
                    "PYTHONPATH": "${workspaceFolder}/src;${workspaceFolder}"
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "Run Tests",
            "type": "shell",
            "command": ".venv\\Scripts\\pytest.exe tests/ -v",
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "options": {
                "env": {
                    "PYTHONPATH": "${workspaceFolder}/src;${workspaceFolder}"
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "DB Migrate (Alembic Upgrade)",
            "type": "shell",
            "command": ".venv\\Scripts\\alembic.exe upgrade head",
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        }
    ]
}
